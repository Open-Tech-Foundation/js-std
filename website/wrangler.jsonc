{
  // Cloudflare Workers static-assets deploy for the js-std docs site.
  // Only the built site (./dist) is uploaded — NOT the whole folder, so
  // node_modules is never sent to the 25 MiB cap.
  "name": "js-std",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist"
  }
}
